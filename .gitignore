.claude/

# Generated by Nix dev shell (nix develop) — do not commit
.pre-commit-config.yaml
# Nix build result symlink
result
.direnv/

### Rust template
# Generated by Cargo
# will have compiled files and executables
debug/
target/

# These are backup files generated by rustfmt
**/*.rs.bk

# MSVC Windows builds of rustc generate these, which store debugging information
*.pdb

# Generated by cargo mutants
**/mutants.out*/

# wasm-pack
bin/
pkg/
wasm-pack.log

# RustRover
#.idea/

# Ignore locally installed cargo binaries but keep committed cargo config.
# The `/.cargo/*` glob (not `/.cargo/`) is required so the negations below can
# re-include specific files — a parent-directory ignore cannot be overridden.
/.cargo/*
!/.cargo/audit.toml
!/.cargo/config.toml

*.log

# nested test workspace build artifacts
/tests/integration/target
